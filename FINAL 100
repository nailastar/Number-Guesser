# ==========================================
# GET PLAYER GUESS
# ==========================================

def get_guess():

    while True:

        guess = input("\nEnter your guess: ")

        try:

            guess = int(guess)

            if guess < MIN_NUMBER:

                print("Your number is too small.")
                print("Please enter a number from 1 to 100.")

            elif guess > MAX_NUMBER:

                print("Your number is too large.")
                print("Please enter a number from 1 to 100.")

            else:

                return guess

        except ValueError:

            print("Invalid input.")
            print("Please enter a whole number.")


# ==========================================
# CHECK PLAYER GUESS
# ==========================================

def check_guess(guess, number):

    if guess == number:

        return "correct"

    elif guess < number:

        return "low"

    else:

        return "high"


# ==========================================
# DISPLAY GUESS RESULT
# ==========================================

def display_guess_result(result):

    if result == "low":

        print("\nToo Low!")
        print("Try guessing a higher number.")

    elif result == "high":

        print("\nToo High!")
        print("Try guessing a lower number.")

    elif result == "correct":

        print("\nCorrect!")
        print("You found the secret number!")


# ==========================================
# DISPLAY WIN MESSAGE
# ==========================================

def display_win_message(attempt):

    print("\n" + "=" * 40)
    print("          CONGRATULATIONS!")
    print("=" * 40)

    print("You guessed the correct number!")
    print("Number of guesses:", attempt)

    print("You successfully won the game!")

    print("=" * 40)


# ==========================================
# DISPLAY GAME OVER MESSAGE
# ==========================================

def display_game_over(number):

    print("\n" + "=" * 40)
    print("              GAME OVER")
    print("=" * 40)

    print("The correct number was:", number)

    print("Thank you for playing!")

    print("=" * 40)


# ==========================================
# PLAY THE GAME
# ==========================================

def play_game():

    global games_played
    global games_won
    global total_guesses
    global best_score

    # Generate a random number
    random_number = random.randint(
        MIN_NUMBER,
        MAX_NUMBER
    )

    # Start counting guesses
    attempts = 0

    # Display introduction
    game_introduction()

    # Continue until the player wins
    while True:

        # Get a valid player guess
        guess = get_guess()

        # Count the guess
        attempts += 1

        # Check the guess
        result = check_guess(
            guess,
            random_number
        )

        # Display the result
        display_guess_result(result)

        # Check whether the player won
        if result == "correct":

            # Display congratulations
            display_win_message(attempts)

            # Update statistics
            games_won += 1
            total_guesses += attempts

            # Update best score
            if best_score == 0:

                best_score = attempts

            elif attempts < best_score:

                best_score = attempts

            break

        # Display remaining instructions
        else:

            print("Attempts so far:", attempts)

            print("Keep trying!")

    # Count completed games
    games_played += 1


# ==========================================
# DISPLAY GAME STATISTICS
# ==========================================

def display_statistics():

    print("\n" + "=" * 40)
    print("           GAME STATISTICS")
    print("=" * 40)

    print("Games Played:", games_played)

    print("Games Won:", games_won)

    print("Total Guesses:", total_guesses)

    if games_won > 0:

        print("Best Score:", best_score)

        average = total_guesses / games_won

        print("Average Guesses:", round(average, 2))

    else:

        print("Best Score: No wins yet.")

        print("Average Guesses: No data yet.")

    print("=" * 40)


