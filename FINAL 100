
import random

attempts = 7


def display_menu():
    print("\n" + "=" * 35)
    print("       NUMBER GUESSING GAME")
    print("=" * 35)
    print("1. Start Game")
    print("2. Game Rules")
    print("=" * 35)


def display_rules():
    print("\n" + "=" * 35)
    print("           GAME RULES")
    print("=" * 35)
    print("1. The computer selects a random number")
    print("   between 1 and 100.")
    print("2. You have 7 attempts to guess the number.")
    print("3. If your guess is too low, you will")
    print("   be told to guess higher.")
    print("4. If your guess is too high, you will")
    print("   be told to guess lower.")
    print("5. Guess the correct number to win!")
    print("=" * 35)

    print("\n1. Return to Menu")

    while True:
        choice = input("\nEnter your choice: ")

        if choice == "1":
            return
        else:
            print("Invalid choice. Please enter 1.")


def play_game(number, attempt=1):

    if attempt > attempts:
        print("\nGame Over!")
        print("The correct number was:", number)
        return

    guess = input(
        f"Attempt {attempt}/7 - Enter your guess: "
    )

    try:
        guess = int(guess)

    except ValueError:
        print("Please enter a valid number.\n")
        return play_game(number, attempt)

    if guess < 1 or guess > 100:
        print("Please enter a number between 1 and 100.\n")
        return play_game(number, attempt)

    check_guess = lambda x, y: "correct" if x == y else (
        "low" if x < y else "high"
    )

    result = check_guess(guess, number)

    if result == "correct":
        print("\nCongratulations!")
        print("You guessed the correct number!")
        print("You guessed it in", attempt, "attempt(s).")
        return

    if result == "low":
        print("Too Low! Try a higher number.\n")

    else:
        print("Too High! Try a lower number.\n")

    play_game(number, attempt + 1)


def start_game():

    print("\nStarting Number Guessing Game!")
    print("I have selected a number between 1 and 100.")
    print("You have 7 attempts to guess it.\n")

    random_number = random.randint(1, 100)

    play_game(random_number)


def main():

    while True:

        display_menu()

        choice = input("\nEnter your choice (1-2): ")

        if choice == "1":

            start_game()

        elif choice == "2":

            display_rules()

        else:

            print("\nInvalid choice.")
            print("Please select 1 or 2.")


# Start the program
main()
