# INPUT VALIDATION


def validate_integer(user_input):
    """Check whether the input is a whole number."""

    try:
        int(user_input)
        return True

    except ValueError:
        return False


def validate_range(guess):
    """Check whether the guess is within the range."""

    if guess >= MIN_NUMBER and guess <= MAX_NUMBER:
        return True

    return False


def get_valid_guess():
    """Ask the player for a valid guess."""

    while True:

        user_input = input("Enter your guess (1-100): ")

        user_input = user_input.strip()

        if not validate_integer(user_input):

            print("Invalid input!")
            print("Please enter a whole number.")

            continue

        guess = int(user_input)

        if not validate_range(guess):

            print("Your number is outside the allowed range.")
            print("Please enter a number between 1 and 100.")

            continue

        return guess


