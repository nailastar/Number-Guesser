    """Control the entire program."""

    # Display the welcome message.
    display_welcome()

    # Continue showing the menu.
    while True:

        # Display the available options.
        display_menu()

        # Get the player's selection.
        choice = get_menu_choice()

        # Start a new game.
        if choice == "1":

            start_new_game()

        # Show instructions.
        elif choice == "2":

            open_instructions()

        # Show statistics.
        elif choice == "3":

            open_statistics()

        # Show game rules.
        elif choice == "4":

            open_rules()

        # Reset statistics.
        elif choice == "5":

            open_reset_menu()

        # Exit the game.
        elif choice == "6":

            answer = input(
                "Are you sure you want to exit? (yes/no): "
            ).strip().lower()

            if answer in ["yes", "y"]:

                display_goodbye()

                break

            else:

                print("Returning to the main menu.")

                time.sleep(1)


