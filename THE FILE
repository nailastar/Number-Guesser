# SECTION : ADDITIONAL GAME HINTS

def check_if_even(number):
    """Check whether a number is even."""

    return number % 2 == 0


def check_if_odd(number):
    """Check whether a number is odd."""

    return number % 2 != 0


def get_number_type(number):
    """Return whether a number is even or odd."""

    if check_if_even(number):

        return "Even"

    return "Odd"


def display_number_type(number):
    """Display whether the number is even or odd."""

    number_type = get_number_type(number)

    print("The number is:", number_type)


def calculate_distance(guess, secret_number):
    """Calculate the distance between two numbers."""

    distance = abs(secret_number - guess)

    return distance


def display_distance_hint(guess, secret_number):
    """Give an additional distance hint."""

    distance = calculate_distance(
        guess,
        secret_number
    )

    if distance <= 5:

        print("You are extremely close!")

    elif distance <= 10:

        print("You are very close!")

    elif distance <= 20:

        print("You are getting closer!")

    elif distance <= 40:

        print("You are still somewhat far away.")

    else:

        print("You are far away from the number.")


def calculate_middle(lower, upper):
    """Calculate the middle of two numbers."""

    return (lower + upper) // 2


# SECTION : GAME STATS

def create_default_statistics():
    """Create the default statistics dictionary."""

    statistics = {

        "games_played": 0,

        "games_won": 0,

        "total_guesses": 0,

        "best_guesses": None,

        "average_guesses": 0

    }

    return statistics


def load_statistics():
    """Load saved statistics from a JSON file."""

    if not os.path.exists(STATS_FILE):

        return create_default_statistics()

    try:

        with open(
            STATS_FILE,
            "r",
            encoding="utf-8"
        ) as file:

            statistics = json.load(file)

        defaults = create_default_statistics()

        for key, value in defaults.items():

            if key not in statistics:

                statistics[key] = value

        return statistics

    except (json.JSONDecodeError, OSError):

        print("Unable to load saved statistics.")

        return create_default_statistics()


def save_statistics(statistics):
    """Save the statistics dictionary."""

    try:

        with open(
            STATS_FILE,
            "w",
            encoding="utf-8"
        ) as file:

            json.dump(
                statistics,
                file,
                indent=4
            )

    except OSError:

        print("Unable to save statistics.")


def update_statistics(statistics, attempts):
    """Update statistics after winning a game."""

    statistics["games_played"] += 1

    statistics["games_won"] += 1

    statistics["total_guesses"] += attempts

    current_best = statistics["best_guesses"]

    if current_best is None:

        statistics["best_guesses"] = attempts

    elif attempts < current_best:

        statistics["best_guesses"] = attempts

    games = statistics["games_played"]

    total = statistics["total_guesses"]

    statistics["average_guesses"] = total / games

    save_statistics(statistics)


def display_statistics():
    """Display the player's saved statistics."""

