# SECTION : MAIN GAME FUNCTION

def play_game():
    """Run one complete guessing game."""

    # Generate a random secret number.
    secret_number = create_new_number()

    # Initialize the guess counter.
    attempts = initialize_attempts()

    # Create an empty guess history.
    history = create_guess_history()

    # Display game information.
    display_title()

    print("The computer has selected a number.")
    print("The number is between 1 and 100.")
    print("You can guess as many times as you want!")
    print("There is no attempt limit.")

    print_small_line()

    # Continue until the player guesses correctly.
    while True:

        # Ask for a valid guess.
        guess = get_valid_guess()

        # Increase the attempt counter.
        attempts = increase_attempts(attempts)

        # Add the guess to the history.
        add_guess_to_history(history, guess)

        # Display the current number of attempts.
        display_attempts(attempts)

        # Check the player's guess.
        result = provide_hint(
            guess,
            secret_number
        )

        # Check whether the player won.
        if result == "CORRECT":

            # Display the winning message.
            display_winning_message()

            # Display the final attempt count.
            display_final_attempts(attempts)

            # Display a performance message.
            display_performance_message(attempts)

            # Update saved statistics.
            statistics = load_statistics()

            update_statistics(
                statistics,
                attempts
            )

            # Display the guess history.
            display_guess_history(history)

            # End the current round.
            break

        # Display the most recent guess.
        display_last_guess(history)

        # The game continues without an attempt limit.

    # Return the number of guesses.
    return attempts


# SECTION : REPLAY FUNCTION

def ask_to_play_again():
    """Ask whether the player wants another game."""

    while True:

        answer = input(
            "Would you like to play again? (yes/no): "
        )

        answer = answer.strip().lower()

        if answer in ["yes", "y"]:

            return True

        elif answer in ["no", "n"]:

            return False

        else:

            print("Please enter yes or no.")


def replay_game():
    """Allow the player to play multiple rounds."""

    while True:

        play_game()

        if ask_to_play_again():

            print()
            print("Starting a new game...")

            time.sleep(1)

        else:

            print("Returning to the main menu.")

            break


