# SECTION : RANDOM NUMBER GENERATION

def generate_secret_number():
    """Generate the computer's secret number."""

    secret_number = random.randint(
        MIN_NUMBER,
        MAX_NUMBER
    )

    return secret_number


def verify_secret_number(secret_number):
    """Verify that the generated number is valid."""

    if secret_number >= MIN_NUMBER:
        if secret_number <= MAX_NUMBER:
            return True

    return False


def create_new_number():
    """Generate and verify a new number."""

    number = generate_secret_number()

    while not verify_secret_number(number):
        number = generate_secret_number()

    return number


# SECTION : INPUT VALIDATION

def validate_integer(user_input):
    """Check whether the input is a whole number."""

    try:
        int(user_input)
        return True

    except ValueError:
        return False


def validate_range(guess):
    """Check whether the guess is within the range."""

    if guess >= MIN_NUMBER and guess <= MAX_NUMBER:
        return True

    return False


def get_valid_guess():
    """Ask the player for a valid guess."""

    while True:

        user_input = input("Enter your guess (1-100): ")

        user_input = user_input.strip()

        if not validate_integer(user_input):

            print("Invalid input!")
            print("Please enter a whole number.")

            continue

        guess = int(user_input)

        if not validate_range(guess):

            print("Your number is outside the allowed range.")
            print("Please enter a number between 1 and 100.")

            continue

        return guess


# SECTION : HIGHER AND LOWER HINTS

def check_guess(guess, secret_number):
    """Compare the player's guess with the secret number."""

    if guess < secret_number:

        return "LOWER_THAN_SECRET"

    elif guess > secret_number:

        return "HIGHER_THAN_SECRET"

    else:

        return "CORRECT"


def display_hint(result):
    """Display the correct hint."""

    if result == "LOWER_THAN_SECRET":

        print()
        print("TOO LOW!")
        print("Try guessing HIGHER!")
        print()

    elif result == "HIGHER_THAN_SECRET":

        print()
        print("TOO HIGH!")
        print("Try guessing LOWER!")
        print()

    elif result == "CORRECT":

        print()
        print("CORRECT!")
        print("You found the secret number!")
        print()


def provide_hint(guess, secret_number):
    """Provide a hint after every guess."""

    result = check_guess(guess, secret_number)

    display_hint(result)

    return result


